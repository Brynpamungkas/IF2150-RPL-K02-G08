# Salin menjadi .env lalu sesuaikan. JANGAN commit file .env.
# Nilai di bawah hanya untuk pengembangan lokal.

# Koneksi database (dibaca oleh aplikasi dan docker-compose.yml)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=klimpool
DB_USER=klimpool
DB_PASSWORD=ganti_password_ini
DB_ROOT_PASSWORD=ganti_password_root_ini
DB_CONNECTION_LIMIT=10

# Penyimpanan berkas dokumentasi progres (UC09, KF24)
# DOKUMENTASI_DRIVER saat ini hanya mendukung nilai "lokal".
DOKUMENTASI_DRIVER=lokal
DOKUMENTASI_DIR=./uploads
